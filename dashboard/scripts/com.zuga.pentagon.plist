<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zuga.pentagon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/zugabot/Projects/ZugaShield/dashboard/scripts/start.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/zugabot/Projects/ZugaShield/dashboard/backend</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/pentagon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pentagon-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/zugabot/Projects/ZugaShield/dashboard/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- No ZUGASHIELD_REPO_PATH override needed: the dashboard runs from a
             real ZugaShield checkout, so config.py's default (two parents up =
             the repo root) already has zugashield/signatures + benchmarks/. -->
    </dict>
</dict>
</plist>
